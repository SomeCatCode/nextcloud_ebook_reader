{
	"name": "fkurth/ebookreader",
	"description": "E-book library, reader and editor for Nextcloud",
	"type": "project",
	"license": "AGPL-3.0-or-later",
	"authors": [
		{
			"name": "Felix Kurth",
			"email": "it@wasmitleder.de"
		}
	],
	"require": {
		"php": ">=8.2",
		"ext-zip": "*",
		"ext-gd": "*",
		"ext-dom": "*",
		"ext-libxml": "*",
		"ext-mbstring": "*"
	},
	"require-dev": {
		"nextcloud/ocp": "dev-stable34",
		"phpunit/phpunit": "^11",
		"vimeo/psalm": "^6",
		"nextcloud/coding-standard": "^1.3",
		"nextcloud/openapi-extractor": "^1.0"
	},
	"autoload": {
		"psr-4": {
			"OCA\\EbookReader\\": "lib/"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"OCA\\EbookReader\\Tests\\": "tests/"
		}
	},
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true,
		"platform": {
			"php": "8.2.27"
		}
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"scripts": {
		"lint": "find lib tests templates -name '*.php' -print0 | xargs -0 -n1 php -l",
		"cs:check": "php-cs-fixer fix --dry-run --diff",
		"cs:fix": "php-cs-fixer fix",
		"psalm": "psalm --threads=1 --no-cache",
		"test:unit": "phpunit -c phpunit.xml",
		"openapi": "generate-spec --verbose"
	}
}
