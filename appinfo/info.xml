<info xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="https://apps.nextcloud.com/schema/apps/info.xsd">
	<id>ebookreader</id>
	<name>E-Book Reader</name>
	<summary>Read, organise and edit e-books (EPUB, MOBI, AZW3, FB2, CBZ, CBR) in Nextcloud</summary>
	<description><![CDATA[A library, reader and metadata/content editor for e-books and comics with reading progress sync.]]></description>
	<version>0.3.1</version>
	<licence>AGPL-3.0-or-later</licence>
	<author mail="f.kurth@lan1.de">Felix Kurth</author>
	<namespace>EbookReader</namespace>
	<category>multimedia</category>
	<category>office</category>
	<website>https://github.com/SomeCatCode/nextcloud_ebook_reader</website>
	<bugs>https://github.com/SomeCatCode/nextcloud_ebook_reader/issues</bugs>
	<repository type="git">https://github.com/SomeCatCode/nextcloud_ebook_reader.git</repository>
	<dependencies>
		<php min-version="8.2"/>
		<nextcloud min-version="34" max-version="34"/>
	</dependencies>
	<repair-steps>
		<post-migration>
			<step>OCA\EbookReader\Migration\RegisterMimeTypes</step>
		</post-migration>
	</repair-steps>
	<background-jobs>
		<job>OCA\EbookReader\BackgroundJob\RescanJob</job>
		<job>OCA\EbookReader\BackgroundJob\CleanupTombstonesJob</job>
	</background-jobs>
	<commands>
		<command>OCA\EbookReader\Command\Scan</command>
		<command>OCA\EbookReader\Command\Inspect</command>
	</commands>
	<navigations>
		<navigation>
			<name>E-Books</name>
			<route>ebookreader.page.index</route>
			<icon>app.svg</icon>
		</navigation>
	</navigations>
</info>
