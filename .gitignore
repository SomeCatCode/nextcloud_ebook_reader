# Anchored to the repo root on purpose: packages/reader-core/vendor/ (vendored foliate-js) must be committed
/node_modules/
/vendor/
/js/
/css/
/build/
/dist/
/.tools/
/.phpunit.cache/
/.php-cs-fixer.cache
*.log
.idea/
.vscode/
.DS_Store

# Secrets: never commit keys, certificates with private parts or local env files
# (e.g. the App Store signing key ebookreader.key)
*.key
*.pem
*.p12
*.pfx
.env
.env.*
